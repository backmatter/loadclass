FROM oven/bun:1.3.9-slim

WORKDIR /app
ENV NODE_ENV=development

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    latexmk \
    poppler-utils \
    texlive-latex-base \
    texlive-latex-extra \
    texlive-latex-recommended \
	    texlive-fonts-recommended \
	    texlive-luatex \
	    texlive-plain-generic \
	    texlive-science \
	    texlive-xetex \
	  && rm -rf /var/lib/apt/lists/*

COPY package.json bun.lock tsconfig.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/cli/package.json apps/cli/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/registry-contract/package.json packages/registry-contract/package.json

RUN bun install --frozen-lockfile --ignore-scripts

COPY apps/api apps/api
COPY packages/db packages/db
COPY packages/registry-contract packages/registry-contract

RUN addgroup --system loadclass \
  && adduser --system --ingroup loadclass --home /tmp/loadclass --disabled-password loadclass

WORKDIR /app/apps/api
ENV NODE_ENV=production
ENV PREVIEW_WORKER_PORT=8090
USER loadclass
EXPOSE 8090

CMD ["bun", "src/workers/template-preview.ts"]
