{
  "name": "loadclass",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "dev:api": "bun run --cwd apps/api dev",
    "build": "bun run --cwd apps/web build",
    "typecheck": "bun run --cwd packages/registry-contract typecheck && bun run --cwd packages/db typecheck && bun run --cwd apps/api typecheck && bun run --cwd apps/web typecheck && bun run --cwd apps/cli typecheck",
    "commit": "bunx cz",
    "prepare": "lefthook install",
    "commitlint": "commitlint",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun run --cwd packages/db migrate",
    "db:studio": "bun run --cwd packages/db studio"
  },
  "dependencies": {
    "@loadclass/registry-contract": "workspace:*",
    "@aws-sdk/client-s3": "^3.925.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "commitizen": "^4.3.1",
    "cz-git": "^1.13.0",
    "lefthook": "^2.0.4",
    "nitro": "npm:nitro-nightly@latest",
    "oxfmt": "^0.48.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.3.9",
  "config": {
    "commitizen": {
      "path": "cz-git"
    }
  }
}
