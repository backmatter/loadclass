# Database
LOADCLASS_RUNTIME_ENV=development
DATABASE_URL=postgresql://loadclass:loadclass-dev-password@localhost:5433/loadclass

# Object storage (MinIO or any S3-compatible)
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_ACCESS_KEY=loadclass
S3_SECRET_KEY=loadclass-dev-password
S3_BUCKET=loadclass

# Better Auth. Dev-only default so `cp .env.example .env` works locally.
# For production, replace with: openssl rand -base64 32
BETTER_AUTH_SECRET=loadclass-dev-auth-secret-change-before-production
# Required in production when web and API are on sibling hosts like app.example.com/api.example.com.
LOADCLASS_AUTH_COOKIE_DOMAIN=
LOADCLASS_GOOGLE_CLIENT_ID=
LOADCLASS_GOOGLE_CLIENT_SECRET=
LOADCLASS_GITHUB_CLIENT_ID=
LOADCLASS_GITHUB_CLIENT_SECRET=

# Optional social sign-in buttons shown by the web app.
# Leave empty for email/password-only self-hosting.
LOADCLASS_AUTH_PROVIDERS=
LOADCLASS_EMAIL_PASSWORD_AUTH_ENABLED=true

# Registry identity (shown in /.well-known/loadclass)
REGISTRY_NAME=loadclass
LOADCLASS_PUBLIC_API_URL=http://localhost:8080
LOADCLASS_INTERNAL_API_URL=http://localhost:8080
UPSTREAM_REGISTRIES=

# Public URL of the web app (used in email links and metadata)
LOADCLASS_SITE_URL=http://localhost:3001

# SMTP — defaults to Mailhog (included in docker-compose for local dev)
# Replace with your SMTP server for production
LOADCLASS_SMTP_HOST=localhost
DOCKER_LOADCLASS_SMTP_HOST=mailhog
LOADCLASS_SMTP_PORT=1025
LOADCLASS_SMTP_USER=
LOADCLASS_SMTP_PASS=
LOADCLASS_EMAIL_FROM="loadclass <noreply@example.invalid>"

# Trusted origins for auth cookies + CORS
TRUSTED_ORIGINS=http://localhost:3001
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# Optional cIteT integration. Leave empty to hide "Create project from template".
LOADCLASS_CITET_URL=

# Registration/publishing controls (set to "false" to lock down)
ALLOW_REGISTRATION=true
ALLOW_PUBLISHING=true
MAX_ARCHIVE_BYTES=26214400
# Optional full multipart request cap. Defaults to MAX_ARCHIVE_BYTES + 1MiB when unset.
MAX_PUBLISH_BODY_BYTES=
MAX_TEMPLATES_PER_USER=5
MAX_VERSIONS_PER_TEMPLATE=10
DOWNLOAD_IP_HASH_SALT=

# Rate limits. Uses PostgreSQL by default so limits work across API replicas.
RATE_LIMIT_STORE=postgres
TRUST_PROXY_HEADERS=false
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_API_PER_MINUTE=600
RATE_LIMIT_MUTATION_PER_MINUTE=120
RATE_LIMIT_DOWNLOAD_PER_MINUTE=120
RATE_LIMIT_PUBLISH_PER_HOUR=5
RATE_LIMIT_PUBLISH_IP_PER_HOUR=20

# Template preview/thumbnail worker.
# Dev-only default so `cp .env.example .env` works locally.
# For production, replace with: openssl rand -base64 32
# Publishing requires this worker to compile the uploaded template and generate a PNG thumbnail.
PREVIEW_WORKER_TOKEN=loadclass-dev-preview-token-change-before-production
TEMPLATE_PREVIEW_TIMEOUT_MS=45000
PREVIEW_WORKER_JOB_TIMEOUT_MS=30000
PREVIEW_WORKER_COMMAND_TIMEOUT_MS=15000
MAX_PREVIEW_REQUEST_BYTES=40000000
MAX_PREVIEW_EXTRACTED_BYTES=83886080
MAX_PREVIEW_FILES=300
MAX_THUMBNAIL_BYTES=3145728

# MinIO credentials (docker-compose only)
POSTGRES_PASSWORD=loadclass-dev-password
MINIO_ROOT_USER=loadclass
MINIO_ROOT_PASSWORD=loadclass-dev-password

# Optional docker-compose host port overrides
API_PORT=8080
WEB_PORT=3001
POSTGRES_PORT=5433
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025
